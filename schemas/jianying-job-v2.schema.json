{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme-ai.github.io/jianying-cli/schemas/jianying-job-v2.schema.json",
  "title": "Jianying Job v2",
  "type": "object",
  "required": ["schema", "operation"],
  "properties": {
    "schema": { "const": "jianying-job/v2" },
    "operation": {
      "enum": ["create", "edit", "inspect", "verify", "publish", "export", "batch"]
    },
    "project": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "project"],
          "properties": {
            "type": { "const": "new" },
            "project": { "$ref": "#/$defs/draftProject" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "source"],
          "properties": {
            "type": { "const": "existing" },
            "source": { "type": "string", "minLength": 1 },
            "output": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "compatibility": {
      "type": "object",
      "required": ["schema", "payload"],
      "properties": {
        "schema": { "enum": ["jianying-cli-plan/v1", "capcut-cli-compile/v1"] },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "required": ["kind", "output", "overwrite"],
      "properties": {
        "kind": { "enum": ["native", "proxy", "draft_archive"] },
        "output": { "type": "string", "minLength": 1 },
        "overwrite": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/editOperation" }
    },
    "jobs": {
      "type": "array",
      "items": { "$ref": "#" }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "required": ["start_us", "duration_us"],
      "properties": {
        "start_us": { "type": "integer", "minimum": 0 },
        "duration_us": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "cropSettings": {
      "type": "object",
      "required": [
        "upper_left_x", "upper_left_y", "upper_right_x", "upper_right_y",
        "lower_left_x", "lower_left_y", "lower_right_x", "lower_right_y"
      ],
      "properties": {
        "upper_left_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper_left_y": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper_right_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper_right_y": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower_left_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower_left_y": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower_right_x": { "type": "number", "minimum": 0, "maximum": 1 },
        "lower_right_y": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "keyframePoint": {
      "type": "object",
      "required": ["at_us", "value"],
      "properties": {
        "at_us": { "type": "integer", "minimum": 0 },
        "value": { "type": "number" }
      },
      "additionalProperties": false
    },
    "keyframes": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "items": { "$ref": "#/$defs/keyframePoint" }
      }
    },
    "mask": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "center_x": { "type": "number" },
        "center_y": { "type": "number" },
        "size": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "feather": { "type": "number", "minimum": 0, "maximum": 100 },
        "invert": { "type": "boolean" },
        "rect_width": { "type": "number", "minimum": 0.01, "maximum": 1 },
        "round_corner": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "chromaKey": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
        "intensity": { "type": "number", "minimum": 0, "maximum": 100 },
        "shadow": { "type": "number", "minimum": 0, "maximum": 100 },
        "edge_smooth": { "type": "number", "minimum": 0, "maximum": 100 },
        "spill": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "backgroundFilling": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["blur", "color"] },
        "blur": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "pattern": "^(|#?[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?)$" }
      },
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_us": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "duration_us": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "fade": {
      "type": "object",
      "required": ["in_us", "out_us"],
      "properties": {
        "in_us": { "type": "integer", "minimum": 0 },
        "out_us": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "audioEffect": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "params": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      },
      "additionalProperties": false
    },
    "textBackground": {
      "type": "object",
      "required": ["color"],
      "properties": {
        "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
        "style": { "enum": [1, 2] },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "round_radius": { "type": "number" },
        "height": { "type": "number" },
        "width": { "type": "number" },
        "horizontal_offset": { "type": "number" },
        "vertical_offset": { "type": "number" }
      },
      "additionalProperties": false
    },
    "textShadow": {
      "type": "object",
      "properties": {
        "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "angle": { "type": "number", "minimum": -180, "maximum": 180 },
        "distance": { "type": "number", "minimum": 0, "maximum": 100 },
        "diffuse": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "styleRange": {
      "type": "object",
      "required": ["range"],
      "properties": {
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "size": { "type": "number", "minimum": 1, "maximum": 100 },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "color": { "type": "string", "pattern": "^#?[0-9A-Fa-f]{6}$" }
      },
      "additionalProperties": false
    },
    "rawIds": {
      "type": "object",
      "required": ["effect_id", "resource_id"],
      "properties": {
        "effect_id": { "type": "string", "minLength": 1 },
        "resource_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "videoSegment": {
      "type": "object",
      "required": ["type", "id", "range", "material_id", "source_range", "speed", "volume"],
      "properties": {
        "type": { "const": "video" },
        "id": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/timeRange" },
        "material_id": { "type": "string", "minLength": 1 },
        "source_range": { "$ref": "#/$defs/timeRange" },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "volume": { "type": "number", "minimum": 0, "maximum": 4 },
        "change_pitch": { "type": "boolean" },
        "scale": { "type": "number", "minimum": 0.01, "maximum": 10 },
        "x": { "type": "number", "minimum": -2, "maximum": 2 },
        "y": { "type": "number", "minimum": -2, "maximum": 2 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "crop": { "$ref": "#/$defs/cropSettings" },
        "keyframes": { "$ref": "#/$defs/keyframes" },
        "mask": { "$ref": "#/$defs/mask" },
        "chroma": { "$ref": "#/$defs/chromaKey" },
        "background_filling": { "$ref": "#/$defs/backgroundFilling" },
        "mix_mode": { "type": "string", "minLength": 1 },
        "animation_in": { "$ref": "#/$defs/animation" },
        "animation_out": { "$ref": "#/$defs/animation" },
        "animation_group": { "$ref": "#/$defs/animation" },
        "transition_out": { "$ref": "#/$defs/transition" },
        "fade": { "$ref": "#/$defs/fade" }
      },
      "additionalProperties": false
    },
    "audioSegment": {
      "type": "object",
      "required": ["type", "id", "range", "material_id", "source_range", "speed", "volume"],
      "properties": {
        "type": { "const": "audio" },
        "id": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/timeRange" },
        "material_id": { "type": "string", "minLength": 1 },
        "source_range": { "$ref": "#/$defs/timeRange" },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 8 },
        "volume": { "type": "number", "minimum": 0, "maximum": 4 },
        "change_pitch": { "type": "boolean" },
        "keyframes": { "$ref": "#/$defs/keyframes" },
        "fade": { "$ref": "#/$defs/fade" },
        "audio_effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/audioEffect" }
        }
      },
      "additionalProperties": false
    },
    "stickerSegment": {
      "type": "object",
      "required": ["type", "id", "range", "resource_id"],
      "properties": {
        "type": { "const": "sticker" },
        "id": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/timeRange" },
        "resource_id": { "type": "string", "minLength": 1 },
        "scale": { "type": "number", "minimum": 0.01, "maximum": 10 },
        "x": { "type": "number", "minimum": -2, "maximum": 2 },
        "y": { "type": "number", "minimum": -2, "maximum": 2 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "keyframes": { "$ref": "#/$defs/keyframes" }
      },
      "additionalProperties": false
    },
    "filterEffectSegment": {
      "type": "object",
      "required": ["type", "id", "range", "resource_id"],
      "properties": {
        "type": { "enum": ["filter", "effect"] },
        "id": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/timeRange" },
        "resource_id": { "type": "string", "minLength": 1 },
        "intensity": { "type": "number", "minimum": 0, "maximum": 100 },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "filter" } } },
          "then": { "required": ["intensity"] }
        },
        {
          "if": { "properties": { "type": { "const": "effect" } } },
          "then": { "required": ["parameters"] }
        }
      ],
      "additionalProperties": false
    },
    "segment": {
      "oneOf": [
        { "$ref": "#/$defs/videoSegment" },
        { "$ref": "#/$defs/audioSegment" },
        {
          "type": "object",
          "required": ["type", "id", "range", "text"],
          "properties": {
            "type": { "const": "text" },
            "id": { "type": "string", "minLength": 1 },
            "range": { "$ref": "#/$defs/timeRange" },
            "text": { "type": "string", "minLength": 1 },
            "scale": { "type": "number", "minimum": 0.01, "maximum": 10 },
            "x": { "type": "number", "minimum": -2, "maximum": 2 },
            "y": { "type": "number", "minimum": -2, "maximum": 2 },
            "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "keyframes": { "$ref": "#/$defs/keyframes" },
            "animation_in": { "$ref": "#/$defs/animation" },
            "animation_out": { "$ref": "#/$defs/animation" },
            "animation_group": { "$ref": "#/$defs/animation" },
            "size": { "type": "number" },
            "color": { "type": "string" },
            "border_color": { "type": "string" },
            "border_width": { "type": "number", "minimum": 0, "maximum": 100 },
            "bold": { "type": "boolean" },
            "italic": { "type": "boolean" },
            "underline": { "type": "boolean" },
            "alignment": { "type": "integer", "minimum": 0, "maximum": 255 },
            "font": { "type": "string", "minLength": 1 },
            "background": { "$ref": "#/$defs/textBackground" },
            "shadow": { "$ref": "#/$defs/textShadow" },
            "styles": {
              "type": "array",
              "items": { "$ref": "#/$defs/styleRange" }
            },
            "text_effect": { "$ref": "#/$defs/rawIds" },
            "bubble": { "$ref": "#/$defs/rawIds" }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/stickerSegment" },
        { "$ref": "#/$defs/filterEffectSegment" },
        {
          "type": "object",
          "required": ["type", "id", "range", "children"],
          "properties": {
            "type": { "const": "composite" },
            "id": { "type": "string", "minLength": 1 },
            "range": { "$ref": "#/$defs/timeRange" },
            "children": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "track": {
      "type": "object",
      "required": ["id", "kind", "segments"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["video", "audio", "text", "sticker", "filter", "effect", "composite"] },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" }
        }
      },
      "additionalProperties": false
    },
    "material": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "id", "path"],
          "properties": {
            "type": { "enum": ["video", "audio", "image", "font"] },
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "id", "resource_id"],
          "properties": {
            "type": { "const": "editor_resource" },
            "id": { "type": "string", "minLength": 1 },
            "resource_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "editOperation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operation", "material"],
          "properties": {
            "operation": { "const": "add_material" },
            "material": { "$ref": "#/$defs/material" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "track_id", "segment"],
          "properties": {
            "operation": { "const": "add_segment" },
            "track_id": { "type": "string", "minLength": 1 },
            "segment": { "$ref": "#/$defs/segment" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "track_id", "kind"],
          "properties": {
            "operation": { "const": "add_track" },
            "track_id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["video", "audio", "text", "sticker", "filter", "effect"] },
            "index": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "track_id"],
          "properties": {
            "operation": { "const": "remove_track" },
            "track_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "track_id", "index"],
          "properties": {
            "operation": { "const": "reorder_track" },
            "track_id": { "type": "string", "minLength": 1 },
            "index": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "segment_id"],
          "properties": {
            "operation": { "const": "remove_segment" },
            "segment_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "segment_id", "target"],
          "properties": {
            "operation": { "const": "move_segment" },
            "segment_id": { "type": "string", "minLength": 1 },
            "target": { "$ref": "#/$defs/timeRange" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "segment_id", "text"],
          "properties": {
            "operation": { "const": "replace_text" },
            "segment_id": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "draftProject": {
      "type": "object",
      "required": ["name", "width", "height", "frame_rate", "timeline", "materials"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "frame_rate": {
          "type": "object",
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "timeline": {
          "type": "object",
          "required": ["tracks"],
          "properties": {
            "tracks": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/track" }
            }
          },
          "additionalProperties": false
        },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/$defs/material" }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "create" } } },
      "then": {
        "anyOf": [
          { "required": ["project"] },
          { "required": ["compatibility"] }
        ]
      }
    },
    {
      "if": { "properties": { "operation": { "const": "edit" } } },
      "then": {
        "required": ["project", "operations"],
        "properties": { "operations": { "minItems": 1 } }
      }
    },
    {
      "if": { "properties": { "operation": { "enum": ["inspect", "verify", "publish"] } } },
      "then": { "required": ["project"] }
    },
    {
      "if": { "properties": { "operation": { "const": "export" } } },
      "then": { "required": ["project", "export"] }
    },
    {
      "if": { "properties": { "operation": { "const": "batch" } } },
      "then": {
        "required": ["jobs"],
        "properties": { "jobs": { "minItems": 1 } }
      }
    }
  ],
  "additionalProperties": false
}
