{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/jianying-official-resource-preflight-v1.schema.json",
  "title": "JianYing official resource Job preflight",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirements"],
  "properties": {
    "schema_version": {"const": "jianying-official-resource-preflight/v1"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "usage"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "usage": {"enum": ["personal", "commercial", "editorial"]},
          "resource": {"type": "string", "minLength": 1},
          "draft": {"type": "string", "minLength": 1}
        },
        "oneOf": [
          {"required": ["resource"], "not": {"required": ["draft"]}},
          {"required": ["draft"], "not": {"required": ["resource"]}}
        ]
      }
    }
  }
}
