{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/jianying-official-resource-receipt-v1.schema.json",
  "title": "JianYing Official Resource Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "title",
    "resource_kind",
    "tier",
    "identity",
    "acquired_at_epoch_seconds",
    "terms_reference",
    "allowed_usages",
    "restrictions",
    "preview_only"
  ],
  "properties": {
    "schema_version": { "const": "jianying-official-resource-receipt/v1" },
    "asset_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "resource_kind": {
      "enum": [
        "media",
        "music",
        "text_template",
        "sticker",
        "video_effect",
        "transition",
        "caption_style",
        "smart_package",
        "smart_b_roll",
        "filter",
        "adjustment",
        "template",
        "digital_human",
        "animation",
        "sound_effect"
      ]
    },
    "tier": { "enum": ["basic", "professional"] },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file"],
          "properties": {
            "kind": { "const": "downloaded_file" },
            "file": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "byte_length"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "byte_length": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource_id", "resource_sha256", "observed_draft_sha256"],
          "properties": {
            "kind": { "const": "draft_resource" },
            "resource_id": { "type": "string", "minLength": 1 },
            "resource_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "observed_draft_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "acquired_at_epoch_seconds": { "type": "integer", "minimum": 1 },
    "terms_reference": { "type": "string", "minLength": 1 },
    "allowed_usages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["personal", "commercial", "editorial"] }
    },
    "restrictions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "preview_only": { "type": "boolean" }
  }
}
