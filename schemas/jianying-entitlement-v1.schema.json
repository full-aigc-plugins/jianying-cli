{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partme.ai/schemas/jianying-entitlement-v1.schema.json",
  "title": "JianYing Runtime Entitlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edition",
    "status",
    "source",
    "observed_at_epoch_seconds",
    "expires_at_epoch_seconds",
    "capabilities"
  ],
  "properties": {
    "schema_version": { "const": "jianying-entitlement/v1" },
    "edition": { "enum": ["unknown", "basic", "professional"] },
    "status": { "enum": ["unknown", "active", "inactive"] },
    "source": { "enum": ["installation_only", "gui_observed", "provider_verified"] },
    "observed_at_epoch_seconds": { "type": "integer", "minimum": 1 },
    "expires_at_epoch_seconds": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
